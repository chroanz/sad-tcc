# Copie para .env e ajuste conforme o ambiente local.
# O .env nao vai para o repositorio (ver .gitignore).

# --- PostgreSQL ---
POSTGRES_USUARIO=tcc
POSTGRES_SENHA=tcc
POSTGRES_BANCO=sad_compras
POSTGRES_PORTA=5432

# --- API Go ---
API_PORTA=8080
BANCO_URL=postgres://tcc:tcc@localhost:5432/sad_compras?sslmode=disable
OTIMIZADOR_URL=http://localhost:8001
OTIMIZADOR_TIMEOUT_SEGUNDOS=30
JWT_SEGREDO=segredo-de-desenvolvimento-trocar-em-producao
JWT_HORAS_VALIDADE=24
APLICAR_MIGRACOES=true

# Coordenada de partida usada quando o cliente nao informa a origem
# (centro de Juazeiro do Norte/CE - cidade definida como escopo de coleta do TCC)
ORIGEM_PADRAO_LATITUDE=-7.213100
ORIGEM_PADRAO_LONGITUDE=-39.315300

# --- Servico Python de otimizacao ---
MODELO_PORTA=8001
MODELO_LIMITE_TEMPO_SEGUNDOS=10

# --- PWA ---
VITE_API_URL=http://localhost:8080/api/v1
